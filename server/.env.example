# Get these from your Neon project dashboard (neon.tech) -> Connection Details
# "Pooled connection" string:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# "Direct connection" string (used by Prisma migrations, no pgbouncer):
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

PORT=4000
CLIENT_ORIGIN="http://localhost:3000"

# Long random string used to sign auth cookies (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me-to-a-long-random-string"

# Resend (https://resend.com) — leave RESEND_API_KEY blank in dev; emails will
# just be logged to the console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Gewathu.lk <onboarding@resend.dev>"
ADMIN_NOTIFY_EMAIL="admin@gewathu.lk"

# Seeded on `npm run prisma:seed` — log in at /admin/login, then change the password.
ADMIN_SEED_EMAIL="admin@gewathu.lk"
ADMIN_SEED_PASSWORD="changeme123"
