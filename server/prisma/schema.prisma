// Prisma schema for Gewathu.lk — run `npm run prisma:migrate` (in /server) after setting DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  PAYHERE
}

enum Role {
  CUSTOMER
  ADMIN
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  unit        String?
  badge       String?
  featured    Boolean     @default(false)
  priceCents  Int
  imageUrl    String?
  stock       Int         @default(0)
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(CUSTOMER)
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id               String        @id @default(cuid())
  user             User?         @relation(fields: [userId], references: [id])
  userId           String?
  customerName     String
  customerEmail    String
  customerPhone    String
  shippingAddress  String
  city             String
  notes            String?
  paymentMethod    PaymentMethod @default(COD)
  status           OrderStatus   @default(PENDING)
  totalCents       Int
  items            OrderItem[]
  payment          Payment?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  priceCents Int
}

// One row per order, ready for a gateway like PayHere/Stripe to fill in.
model Payment {
  id          String        @id @default(cuid())
  order       Order         @relation(fields: [orderId], references: [id])
  orderId     String        @unique
  provider    String // e.g. "payhere", "stripe"
  reference   String? // provider's transaction/payment id
  status      PaymentStatus @default(PENDING)
  amountCents Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// --- CMS content, admin-editable via /admin/content ---

model HeroSlide {
  id             String   @id @default(cuid())
  order          Int      @default(0)
  eyebrow        String
  titleWhite     String
  titleAccent    String
  body           String
  imageUrl       String?
  primaryLabel   String
  primaryHref    String
  secondaryLabel String
  secondaryHref  String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TrustBadge {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  icon        String
  title       String
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  quote     String
  author    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuideCard {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  number    String
  title     String
  blurb     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row (always id: "singleton") for site-wide, non-list settings.
model SiteSettings {
  id                  String   @id @default("singleton")
  deliveryBannerText  String   @default("Free delivery in selected areas for orders above Rs. 5,000")
  logoUrl             String?
  footerTagline       String   @default("Your local online destination for plants, seeds, tools and everything needed to grow at home.")
  whatsappNumber      String   @default("+94 XX XXX XXXX")
  whatsappLink        String   @default("https://wa.me/94")
  contactEmail        String   @default("hello@gewathu.lk")
  contactLocation     String   @default("Sri Lanka")
  seasonalEyebrow     String   @default("Seasonal essentials")
  seasonalTitle       String   @default("Ready for the next planting season?")
  seasonalBody        String   @default("Choose the right seeds, growing media and tools for a productive home garden.")
  seasonalCtaLabel    String   @default("Shop seasonal picks")
  starterEyebrow      String   @default("Simple way to begin")
  starterTitle        String   @default("Your first home garden, all in one box.")
  starterBody         String   @default("A practical starter bundle with seeds, growing media, hand tools and an easy Sinhala/English planting guide.")
  starterBadge        String   @default("Beginner friendly")
  starterCtaLabel     String   @default("Explore starter kits")
  newsletterEyebrow   String   @default("Grow with us")
  newsletterTitle     String   @default("Fresh ideas for your garden")
  newsletterBody      String   @default("Receive seasonal tips, useful guides and selected offers.")
  updatedAt           DateTime @updatedAt
}
